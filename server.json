{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.looot/looot",
  "title": "looot",
  "description": "Discover, inspect and run 2,500+ data provider operations with one token and one bill.",
  "version": "0.1.0",
  "websiteUrl": "https://looot.ai",
  "repository": {
    "url": "https://github.com/walidboulanouar/looot-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.looot.ai/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "looot-mcp",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "LOOOT_TOKEN",
          "description": "Optional agent token (cs_ms_...). Leave unset to sign in with the browser (OAuth).",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
